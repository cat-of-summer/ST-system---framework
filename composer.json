{
    "name": "cat-of-summer/st-system",
    "description": "ST_system PHP library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "cat-of-summer"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ST_system\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ST_system\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
